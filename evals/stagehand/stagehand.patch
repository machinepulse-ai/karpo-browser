index 000000000..f638d6955
--- /dev/null
+++ b/packages/evals/tests/framework/karpoBrowserRunner.test.ts
@@ -0,0 +1,339 @@
+import fs from "node:fs";
+import fsp from "node:fs/promises";
+import os from "node:os";
+import path from "node:path";
+import { PassThrough } from "node:stream";
+import { afterEach, describe, expect, it, vi } from "vitest";
+import type { AvailableModel } from "stagehand-v3";
+import type { DeepagentsProcessSpawner } from "@browserbasehq/stagehand-integrations-deepagents-sdk";
+import { EVAL_SYSTEM_PROMPT } from "../../framework/evalSystemPrompt.js";
+import type { ExternalHarnessTaskPlan } from "../../framework/externalHarnessPlan.js";
+import { runAgentProgram } from "../../framework/karpoBrowserRunner.js";
+import type { PreparedAgentProgramToolAdapter } from "../../framework/karpoBrowserToolAdapter.js";
+import { EvalLogger } from "../../logger.js";
+
+// fakeAgent is adapted from the fake spawners of deepagentsRunner.test.ts, which tests
+// runDeepagentsAgent (at c8e096cb; Copyright (c) 2024 Browserbase Inc., MIT License).
+
+/**
+ * The row's trajectory directory the task's result names, when a test sets one
+ * (as the verifier does once it has written the trajectory); the result is
+ * otherwise as it comes.
+ */
+const trajectory = vi.hoisted(() => ({ dir: undefined as string | undefined }));
+vi.mock("../../framework/harnesses/externalRunner.js", async (importOriginal) => {
+  const actual =
+    await importOriginal<typeof import("../../framework/harnesses/externalRunner.js")>();
+  return {
+    ...actual,
+    runExternalHarnessTask: async (...args: Parameters<typeof actual.runExternalHarnessTask>) => {
+      const result = await actual.runExternalHarnessTask(...args);
+      return trajectory.dir === undefined ? result : { ...result, trajectoryDir: trajectory.dir };
+    },
+  };
+});
+
+const BIN = "/opt/agent-program/bin/agent";
+
+const plan: ExternalHarnessTaskPlan = {
+  dataset: "hardbenchmark",
+  taskId: "hb-1",
+  startUrl: "https://example.com/start",
+  instruction: "Find the cheapest permit.\nReport the park.",
+};
+
+const mcpServers = {
+  stagehand: { command: "node", args: ["-e", "relay"], env: { PORT: "4242" } },
+};
+
+/** The eval process's environment, as the tool adapter hands it on. */
+const INHERITED_ENV = { PATH: "/usr/bin", AGENT_SETTING: "kept" };
+
+function adapter(observed: string[] = []): PreparedAgentProgramToolAdapter {
+  return {
+    toolSurface: "stagehand_facade",
+    startupProfile: "tool_launch_local",
+    cwd: "/tmp/karpo-browser-runner-test",
+    env: INHERITED_ENV,
+    promptInstructions: "Use the facade tools.",
+    browserSession: { provider: "local" },
+    mcpServers,
+    recordObservation: () => observed.push("observation"),
+    observedToolMatcher: (name) => name.startsWith("stagehand."),
+    cleanup: async () => {},
+  };
+}
+
+/**
+ * A process that records how it was started and what it read, does `onRequest`
+ * with what it read, then prints `events`.
+ */
+function fakeAgent(
+  events: Array<Record<string, unknown>>,
+  onRequest?: (request: Record<string, unknown>) => void,
+) {
+  const started: Array<Parameters<DeepagentsProcessSpawner>[0]> = [];
+  const requests: Array<Record<string, unknown>> = [];
+  const spawn: DeepagentsProcessSpawner = (spec) => {
+    started.push(spec);
+    const stdin = new PassThrough();
+    const stdout = new PassThrough();
+    const stderr = new PassThrough();
+    let raw = "";
+    stdin.on("data", (chunk) => (raw += chunk.toString()));
+    stdin.on("finish", () => {
+      const request = JSON.parse(raw) as Record<string, unknown>;
+      requests.push(request);
+      onRequest?.(request);
+    });
+    queueMicrotask(() => {
+      for (const event of events) stdout.write(`${JSON.stringify(event)}\n`);
+      stdout.end();
+      stderr.end();
+    });
+    return {
+      stdin,
+      stdout,
+      stderr,
+      exited: Promise.resolve({ code: 0, signal: null }),
+      kill: () => {},
+    };
+  };
+  return { spawn, started, requests };
+}
+
+const UNREPORTED_USAGE = {
+  type: "usage",
+  input_tokens: 0,
+  output_tokens: 0,
+  total_tokens: 0,
+  reported: false,
+};
+
+const DONE = {
+  type: "final",
+  text: 'EVAL_RESULT: {"success":true,"summary":"done","finalAnswer":"x"}',
+};
+
+/** The record the agent writes: one JSON file, as karpo-browser's adapter writes it. */
+const RECORD_FILE = "karpo-browser-run.json";
+const RECORDED = '{"report":{"success":true,"summary":"finished","finalAnswer":"x"}}';
+
+/** Writes the agent's record into the directory its input names. */
+function writeRecords(request: Record<string, unknown>): void {
+  const records = request.records_dir as string;
+  fs.mkdirSync(records, { recursive: true });
+  fs.writeFileSync(path.join(records, RECORD_FILE), RECORDED);
+}
+
+/** Runs the harness in the working directory `cwd`, the agent writing its records. */
+async function runRecording(cwd: string, logger = new EvalLogger(false)) {
+  const agent = fakeAgent([DONE, UNREPORTED_USAGE], writeRecords);
+  const result = await runAgentProgram({
+    plan,
+    model: "karpo-browser/controller" as AvailableModel,
+    logger,
+    toolAdapter: { ...adapter(), cwd },
+    spawn: agent.spawn,
+    env: { EVAL_AGENT_BIN: BIN },
+  });
+  return { agent, result };
+}
+
+/** Runs the harness on `toolAdapter` and gives the environment the program was started in. */
+async function startedEnv(toolAdapter: PreparedAgentProgramToolAdapter) {
+  const agent = fakeAgent([DONE, UNREPORTED_USAGE]);
+  await runAgentProgram({
+    plan,
+    model: "karpo-browser/controller" as AvailableModel,
+    logger: new EvalLogger(false),
+    toolAdapter,
+    spawn: agent.spawn,
+    env: { EVAL_AGENT_BIN: BIN },
+  });
+  return agent.started[0]?.env;
+}
+
+describe("karpo_browser runner", () => {
+  afterEach(() => {
+    trajectory.dir = undefined;
+  });
+
+  it("starts the agent program with no arguments, the task, the mount and the budget", async () => {
+    const observed: string[] = [];
+    const agent = fakeAgent([
+      { type: "assistant", text: "CLICK link Permits" },
+      { type: "tool_call", id: "1", name: "run", server: "stagehand", args: {} },
+      { type: "tool_result", id: "1", name: "run", server: "stagehand", ok: true, text: "ok" },
+      {
+        type: "final",
+        text: 'EVAL_RESULT: {"success":true,"summary":"done","finalAnswer":"Big Meadows"}',
+      },
+      UNREPORTED_USAGE,
+    ]);
+    const result = await runAgentProgram({
+      plan,
+      model: "karpo-browser/controller" as AvailableModel,
+      logger: new EvalLogger(false),
+      toolAdapter: adapter(observed),
+      spawn: agent.spawn,
+      env: { EVAL_AGENT_BIN: BIN },
+    });
+
+    expect(agent.started).toEqual([
+      {
+        command: BIN,
+        args: [],
+        cwd: "/tmp/karpo-browser-runner-test",
+        env: INHERITED_ENV,
+      },
+    ]);
+    const [request] = agent.requests;
+    expect(request).toMatchObject({
+      system_prompt: EVAL_SYSTEM_PROMPT,
+      model: "karpo-browser/controller",
+      reasoning_summary: null,
+      mcp_servers: mcpServers,
+      max_tool_steps: 100,
+      result_schema: null,
+      instruction: plan.instruction,
+      start_url: plan.startUrl,
+      run_seconds: 2400,
+      records_dir: "/tmp/karpo-browser-runner-test/agent-records",
+    });
+    expect(request?.prompt).toContain(`Start URL: ${plan.startUrl}`);
+    expect(request?.prompt).toContain("Use the facade tools.");
+    expect(observed).toEqual(["observation"]);
+    expect(result).toMatchObject({
+      _success: true,
+      finalAnswer: "Big Meadows",
+      harnessStatus: "completed",
+      terminationReason: "completed",
+      usageConvention: "unreported",
+      harnessConfiguration: { stepBudget: 100, stepBudgetUnit: "tool_calls", runSeconds: 2400 },
+    });
+  });
+
+  it("gives the program a Browserbase row's session id in BROWSERBASE_SESSION_ID", async () => {
+    // The row's session wins over a value the eval process inherited.
+    const inherited = { ...INHERITED_ENV, BROWSERBASE_SESSION_ID: "inherited" };
+    const toolAdapter = {
+      ...adapter(),
+      env: inherited,
+      browserSession: {
+        provider: "browserbase" as const,
+        sessionId: "bb-session-1",
+        sessionUrl: "https://www.browserbase.com/sessions/bb-session-1",
+      },
+    };
+    expect(await startedEnv(toolAdapter)).toEqual({
+      ...INHERITED_ENV,
+      BROWSERBASE_SESSION_ID: "bb-session-1",
+    });
+    expect(toolAdapter.env).toEqual(inherited);
+
+    // A Browserbase surface that did not report its session, or a local browser: nothing added.
+    expect(await startedEnv({ ...adapter(), browserSession: { provider: "browserbase" } })).toEqual(
+      INHERITED_ENV,
+    );
+    expect(await startedEnv(adapter())).toEqual(INHERITED_ENV);
+  });
+
+  it("takes the budget and the time limit from the environment and reports a budget stop", async () => {
+    const agent = fakeAgent([
+      {
+        type: "error",
+        kind: "tool_step_budget",
+        message: "tool step budget exhausted (12 steps)",
+      },
+      {
+        type: "final",
+        text: 'EVAL_RESULT: {"success":false,"summary":"limit: Stopped after 2 steps.","finalAnswer":null}',
+      },
+      UNREPORTED_USAGE,
+    ]);
+    const result = await runAgentProgram({
+      plan: { ...plan, dataset: "webvoyager" },
+      model: "karpo-browser/controller" as AvailableModel,
+      logger: new EvalLogger(false),
+      toolAdapter: adapter(),
+      spawn: agent.spawn,
+      env: {
+        EVAL_AGENT_BIN: BIN,
+        EVAL_AGENT_MAX_STEPS: "12",
+        EVAL_AGENT_RUN_SECONDS: "300",
+      },
+    });
+
+    expect(agent.requests[0]).toMatchObject({ max_tool_steps: 12, run_seconds: 300 });
+    expect(result).toMatchObject({
+      _success: false,
+      harnessStatus: "max_turns",
+      terminationReason: "step_budget",
+      harnessStopReason: "tool step budget exhausted (12 steps)",
+      harnessConfiguration: { stepBudget: 12, runSeconds: 300 },
+    });
+  });
+
+  it("refuses an agent program that is not given by an absolute path", async () => {
+    for (const env of [{}, { EVAL_AGENT_BIN: "bin/agent" }]) {
+      const agent = fakeAgent([]);
+      await expect(
+        runAgentProgram({
+          plan,
+          model: "karpo-browser/controller" as AvailableModel,
+          logger: new EvalLogger(false),
+          toolAdapter: adapter(),
+          spawn: agent.spawn,
+          env,
+        }),
+      ).rejects.toThrow(/EVAL_AGENT_BIN must be the absolute path of the agent program/);
+      expect(agent.started).toEqual([]);
+    }
+  });
+
+  it("copies the agent's records into the row's trajectory directory, where they outlive its working directory", async () => {
+    const root = await fsp.mkdtemp(path.join(os.tmpdir(), "karpo-browser-runner-records-"));
+    try {
+      const cwd = path.join(root, "work");
+      trajectory.dir = path.join(root, "trajectory");
+      await fsp.mkdir(cwd);
+      await fsp.mkdir(trajectory.dir);
+      const { agent, result } = await runRecording(cwd);
+
+      expect(agent.requests[0]?.records_dir).toBe(path.join(cwd, "agent-records"));
+      expect(result).toMatchObject({ _success: true, trajectoryDir: trajectory.dir });
+      // The working directory is removed after the row, as the tool adapter's cleanup does.
+      await fsp.rm(cwd, { recursive: true, force: true });
+      const kept = path.join(trajectory.dir, "agent", RECORD_FILE);
+      expect(await fsp.readFile(kept, "utf8")).toBe(RECORDED);
+    } finally {
+      await fsp.rm(root, { recursive: true, force: true });
+    }
+  });
+
+  it("copies nothing to a trajectory directory that was not written, and a failed copy fails no row", async () => {
+    const root = await fsp.mkdtemp(path.join(os.tmpdir(), "karpo-browser-runner-records-"));
+    try {
+      const cwd = path.join(root, "work");
+      await fsp.mkdir(cwd);
+      // Trajectories not persisted: the result names a directory that is never made.
+      trajectory.dir = path.join(root, "trajectory");
+      const { result } = await runRecording(cwd);
+      expect(result).toMatchObject({ _success: true });
+      await expect(fsp.stat(trajectory.dir)).rejects.toThrow(/ENOENT/);
+
+      // A copy that fails is logged; the row stands.
+      await fsp.mkdir(trajectory.dir);
+      await fsp.writeFile(path.join(trajectory.dir, "agent"), "");
+      const logger = new EvalLogger(false);
+      const failed = await runRecording(cwd, logger);
+      expect(failed.result).toMatchObject({ _success: true });
+      expect(logger.getLogs().map((line) => line.message)).toContainEqual(
+        expect.stringContaining("could not keep the agent's execution records"),
+      );
+    } finally {
+      await fsp.rm(root, { recursive: true, force: true });
+    }
+  });
+});
diff --git a/packages/evals/tests/framework/karpoBrowserSession.test.ts b/packages/evals/tests/framework/karpoBrowserSession.test.ts
new file mode 100644
index 000000000..a78d1c26e
--- /dev/null
+++ b/packages/evals/tests/framework/karpoBrowserSession.test.ts
@@ -0,0 +1,188 @@
+import { PassThrough } from "node:stream";
+import { afterEach, describe, expect, it, vi } from "vitest";
+import type { DeepagentsProcessSpawner } from "@browserbasehq/stagehand-integrations-deepagents-sdk";
+import {
+  runAgentProgramSession,
+  type AgentProgramSessionConfig,
+} from "../../framework/karpoBrowserSession.js";
+
+// The failure paths of the session adapted from deepagents-sdk's runDeepagentsSession, tested
+// as deepagents-sdk/tests/session.test.ts (at c8e096cb; Copyright (c) 2024 Browserbase Inc.,
+// MIT License) tests the original.
+
+const logger = { log: vi.fn(), warn: vi.fn(), error: vi.fn() };
+
+const session: AgentProgramSessionConfig = {
+  binary: "/opt/agent-program/bin/agent",
+  env: {},
+  mcpServers: { stagehand: { command: "node", args: ["-e", "relay"] } },
+  systemPrompt: "system",
+  maxToolSteps: 12,
+  instruction: "Find the cheapest permit.",
+  startUrl: "https://example.com/",
+  runSeconds: 2400,
+};
+
+type Exit = { code: number | null; signal: NodeJS.Signals | null };
+
+/** A process that prints `lines`, then exits with `code` (0 by default) or `signal`. */
+function fakeSpawner(options: { lines?: string[]; code?: number | null; signal?: NodeJS.Signals }) {
+  const spawn: DeepagentsProcessSpawner = () => {
+    const stdout = new PassThrough();
+    const stderr = new PassThrough();
+    let resolveExit!: (value: Exit) => void;
+    const exited = new Promise<Exit>((resolve) => {
+      resolveExit = resolve;
+    });
+    queueMicrotask(() => {
+      for (const line of options.lines ?? []) stdout.write(`${line}\n`);
+      stdout.end();
+      stderr.end();
+      resolveExit({
+        code: options.code === undefined ? 0 : options.code,
+        signal: options.signal ?? null,
+      });
+    });
+    return { stdin: new PassThrough(), stdout, stderr, exited, kill: () => {} };
+  };
+  return spawn;
+}
+
+/**
+ * A process that records the signals it is sent. It keeps running after SIGTERM until SIGKILL, or
+ * until `exitAfterTermMs` after SIGTERM when given (as the agent reports a stop, then exits 1).
+ */
+function stoppableSpawner(exitAfterTermMs?: number) {
+  const kills: Array<NodeJS.Signals | undefined> = [];
+  const spawn: DeepagentsProcessSpawner = () => {
+    const stdout = new PassThrough();
+    const stderr = new PassThrough();
+    let resolveExit!: (value: Exit) => void;
+    const exited = new Promise<Exit>((resolve) => {
+      resolveExit = resolve;
+    });
+    const exit = (value: Exit) => {
+      stdout.end();
+      stderr.end();
+      resolveExit(value);
+    };
+    return {
+      stdin: new PassThrough(),
+      stdout,
+      stderr,
+      exited,
+      kill: (signal) => {
+        kills.push(signal);
+        if (signal === "SIGKILL") exit({ code: null, signal });
+        else if (exitAfterTermMs !== undefined)
+          setTimeout(() => exit({ code: 1, signal: null }), exitAfterTermMs);
+      },
+    };
+  };
+  return { spawn, kills };
+}
+
+function run(spawn: DeepagentsProcessSpawner, signal?: AbortSignal) {
+  return runAgentProgramSession({
+    prompt: "task",
+    model: "karpo-browser/controller",
+    logger,
+    session,
+    spawn,
+    ...(signal && { signal }),
+  });
+}
+
+describe("karpo_browser session", () => {
+  afterEach(() => {
+    vi.useRealTimers();
+  });
+
+  it("stops the agent with SIGTERM and kills it 5 s later when it is still running", async () => {
+    vi.useFakeTimers();
+    const agent = stoppableSpawner();
+    const controller = new AbortController();
+    const result = run(agent.spawn, controller.signal);
+
+    controller.abort();
+    expect(agent.kills).toEqual(["SIGTERM"]);
+    await vi.advanceTimersByTimeAsync(4_999);
+    expect(agent.kills).toEqual(["SIGTERM"]);
+    await vi.advanceTimersByTimeAsync(1);
+    expect(agent.kills).toEqual(["SIGTERM", "SIGKILL"]);
+    await expect(result).resolves.toMatchObject({
+      status: "sdk_error",
+      stopReason: "agent program terminated by SIGKILL",
+      exitCode: null,
+    });
+  });
+
+  it("does not kill an agent that ends within the 5 s after SIGTERM", async () => {
+    vi.useFakeTimers();
+    const agent = stoppableSpawner(4_000);
+    const controller = new AbortController();
+    const result = run(agent.spawn, controller.signal);
+
+    controller.abort();
+    await vi.advanceTimersByTimeAsync(4_000);
+    await expect(result).resolves.toMatchObject({
+      status: "sdk_error",
+      stopReason: "agent program exited with code 1",
+      exitCode: 1,
+    });
+    await vi.advanceTimersByTimeAsync(10_000);
+    expect(agent.kills).toEqual(["SIGTERM"]);
+  });
+
+  it("reports a non-zero exit as sdk_error, with the agent's reason when it gave one", async () => {
+    await expect(run(fakeSpawner({ code: 1 }))).resolves.toMatchObject({
+      status: "sdk_error",
+      stopReason: "agent program exited with code 1",
+      exitCode: 1,
+    });
+
+    const report = 'EVAL_RESULT: {"success":false,"summary":"failed","finalAnswer":null}';
+    const failed = await run(
+      fakeSpawner({
+        code: 1,
+        lines: [
+          JSON.stringify({ type: "error", kind: "exception", message: "Browser session lost." }),
+          JSON.stringify({ type: "final", text: report }),
+          JSON.stringify({ type: "usage", input_tokens: 0, output_tokens: 0, reported: false }),
+        ],
+      }),
+    );
+    expect(failed).toMatchObject({
+      status: "sdk_error",
+      stopReason: "Browser session lost.",
+      finalMessage: report,
+      exitCode: 1,
+    });
+  });
+
+  it("reports an exit without its final and usage events as sdk_error", async () => {
+    const truncated = await run(
+      fakeSpawner({
+        lines: [
+          JSON.stringify({ type: "assistant", text: "CLICK link Permits" }),
+          '{"type":"final","te',
+        ],
+      }),
+    );
+    expect(truncated).toMatchObject({
+      status: "sdk_error",
+      stopReason: "agent program exited without a terminal final/usage event",
+      finalMessage: "",
+      exitCode: 0,
+    });
+
+    const noUsage = await run(
+      fakeSpawner({ lines: [JSON.stringify({ type: "final", text: "EVAL_RESULT: {}" })] }),
+    );
+    expect(noUsage).toMatchObject({
+      status: "sdk_error",
+      stopReason: "agent program exited without a terminal final/usage event",
+      exitCode: 0,
+    });
+  });
+});
