index 000000000..4185334f9
--- /dev/null
+++ b/packages/evals/framework/karpoBrowserSession.ts
@@ -0,0 +1,415 @@
+/**
+ * One agent program process per task, for the `karpo_browser` harness. The
+ * program (karpo-browser's adapter, named by EVAL_AGENT_BIN) speaks the Deep
+ * Agents runner's protocol (packages/integrations/deepagents/runner/run_eval.py):
+ * one JSON object on stdin, then one JSON event per stdout line in the same
+ * shapes (assistant, tool_call, tool_result, error, final, usage).
+ *
+ * Adapted from runDeepagentsSession
+ * (packages/integrations/deepagents-sdk/src/session.ts at c8e096cb),
+ * Copyright (c) 2024 Browserbase Inc., MIT License (see LICENSE at the
+ * repository root). That session's command and stdin are fixed to the Deep
+ * Agents runner; this copy changes only:
+ * - the command: the agent program, started with no arguments, in place of
+ *   `uv run … run_eval.py`, with the environment it is given;
+ * - stdin: four more fields, the plan's `instruction` and `start_url` and the
+ *   run's time limit `run_seconds` (the agent prefers them to reading the task
+ *   back out of the prompt), and `records_dir`, where the agent keeps its
+ *   execution records; the model label as given, `reasoning_summary` null and
+ *   `recursion_limit` the tool-call budget;
+ * - stop kinds: `tool_step_budget` is the only one a later error cannot
+ *   overwrite, as the agent never reports `recursion_limit`;
+ * - the kill grace and the stream drain, fixed at Deep Agents' default 5 s;
+ *   its own log category and messages;
+ * - the protocol's words (the input's fields, the events' types, kinds and
+ *   fields, the signals) named as module constants.
+ */
+import { createInterface } from "node:readline";
+import {
+  clip,
+  extractDeepagentsTokenUsage,
+  isRecord,
+  resolveDeepagentsStatus,
+  spawnDeepagentsProcess,
+  stringifyError,
+  summarizeDeepagentsEvent,
+  type DeepagentsEvent,
+  type DeepagentsMcpServerConfig,
+  type DeepagentsProcessHandle,
+  type DeepagentsProcessSpawner,
+  type DeepagentsSessionResult,
+} from "@browserbasehq/stagehand-integrations-deepagents-sdk";
+import {
+  harnessEventLogLevel,
+  sanitizeErrorMessage,
+  type HarnessLogger,
+} from "@browserbasehq/stagehand-integrations/harness";
+
+/** The harness's name, which its runs are logged under, as Deep Agents' are under theirs. */
+export const AGENT_PROGRAM_HARNESS = "karpo_browser";
+const LOG_CATEGORY = AGENT_PROGRAM_HARNESS;
+/** The type a logged auxiliary value of text is given. */
+export const STRING_AUXILIARY = "string";
+
+/** How long a stopped agent has to report and exit before it is killed, as Deep Agents has. */
+const KILL_GRACE_MS = 5_000;
+/** How the agent is stopped, then killed. */
+const STOP_SIGNAL = "SIGTERM";
+const KILL_SIGNAL = "SIGKILL";
+/** The events of an abort signal and of a stream that fails. */
+const ABORT_EVENT = "abort";
+const STREAM_ERROR_EVENT = "error";
+
+/**
+ * The fields of the task on the agent's stdin: the Deep Agents runner's, then the
+ * agent's own.
+ */
+const PROMPT_FIELD = "prompt";
+const SYSTEM_PROMPT_FIELD = "system_prompt";
+const MODEL_FIELD = "model";
+const REASONING_SUMMARY_FIELD = "reasoning_summary";
+const MCP_SERVERS_FIELD = "mcp_servers";
+const RECURSION_LIMIT_FIELD = "recursion_limit";
+const MAX_TOOL_STEPS_FIELD = "max_tool_steps";
+const RESULT_SCHEMA_FIELD = "result_schema";
+const INSTRUCTION_FIELD = "instruction";
+const START_URL_FIELD = "start_url";
+const RUN_SECONDS_FIELD = "run_seconds";
+const RECORDS_DIR_FIELD = "records_dir";
+
+/**
+ * The agent's stdout events: the types the session reads, the kinds of error it
+ * tells apart (a budget stop, and an error of no kind), and the fields it reads;
+ * what an event of no type is logged as; and the fields whose text it redacts
+ * wherever they are.
+ */
+const ASSISTANT_EVENT = "assistant";
+const TOOL_RESULT_EVENT = "tool_result";
+const ERROR_EVENT = "error";
+const FINAL_EVENT = "final";
+const USAGE_EVENT = "usage";
+const TOOL_STEP_BUDGET_KIND = "tool_step_budget";
+const EXCEPTION_KIND = "exception";
+const TYPE_FIELD = "type";
+const TEXT_FIELD = "text";
+const KIND_FIELD = "kind";
+const MESSAGE_FIELD = "message";
+const NAME_FIELD = "name";
+const SERVER_FIELD = "server";
+const OK_FIELD = "ok";
+const ERROR_FIELD = "error";
+const DETAIL_FIELD = "detail";
+const UNKNOWN_EVENT = "unknown";
+const SENSITIVE_TEXT_FIELDS: ReadonlySet<string> = new Set([
+  ERROR_FIELD,
+  MESSAGE_FIELD,
+  DETAIL_FIELD,
+]);
+
+export type AgentProgramSessionConfig = {
+  /** Absolute path of the agent program. */
+  binary: string;
+  cwd?: string;
+  env: Record<string, string>;
+  mcpServers: Record<string, DeepagentsMcpServerConfig>;
+  systemPrompt: string;
+  /** The tool-call budget; the agent stops before it would exceed it. */
+  maxToolSteps: number;
+  /** JSON schema of the report when the structured-output contract is on. */
+  resultSchema?: Record<string, unknown>;
+  instruction: string;
+  startUrl: string;
+  /** The run's wall-clock limit in seconds. */
+  runSeconds: number;
+  /**
+   * Absolute path of the directory the agent keeps its execution records in;
+   * without one, it keeps them only while it runs.
+   */
+  recordsDir?: string;
+};
+
+export async function runAgentProgramSession(input: {
+  prompt: string;
+  model: string;
+  logger: HarnessLogger;
+  session: AgentProgramSessionConfig;
+  signal?: AbortSignal;
+  spawn?: DeepagentsProcessSpawner;
+  onToolResult?: (toolName: string, server?: string) => void | Promise<void>;
+}): Promise<DeepagentsSessionResult> {
+  const { session } = input;
+  const events: DeepagentsEvent[] = [];
+  let finalMessage = "";
+  let stopReason: string | undefined;
+  let errorKind: string | undefined;
+  let tokenUsage = extractDeepagentsTokenUsage(undefined);
+  let iterationError: string | undefined;
+  let exitCode: number | null = null;
+  let exitSignal: NodeJS.Signals | null = null;
+  let sawFinal = false;
+  let sawUsage = false;
+  let handle: DeepagentsProcessHandle | undefined;
+  let processExited = false;
+  let killTimer: ReturnType<typeof setTimeout> | undefined;
+  let stdoutTask: Promise<void> | undefined;
+  let stderrTask: Promise<void> | undefined;
+  const sendSignal = (signal: NodeJS.Signals): void => {
+    try {
+      handle?.kill(signal);
+    } catch {
+      // best-effort only
+    }
+  };
+  const beginTermination = (): void => {
+    if (!handle || processExited) return;
+    sendSignal(STOP_SIGNAL);
+    killTimer ??= setTimeout(() => {
+      if (!processExited) sendSignal(KILL_SIGNAL);
+    }, KILL_GRACE_MS);
+  };
+
+  try {
+    handle = (input.spawn ?? spawnDeepagentsProcess)({
+      command: session.binary,
+      // No arguments: the task comes on stdin.
+      args: [],
+      ...(session.cwd && { cwd: session.cwd }),
+      env: session.env,
+    });
+    if (input.signal?.aborted) beginTermination();
+    else input.signal?.addEventListener(ABORT_EVENT, beginTermination, { once: true });
+
+    handle.stdin.on(STREAM_ERROR_EVENT, () => {
+      // Process startup/exit errors are reported through handle.exited.
+    });
+    handle.stdin.end(
+      JSON.stringify({
+        [PROMPT_FIELD]: input.prompt,
+        [SYSTEM_PROMPT_FIELD]: session.systemPrompt,
+        [MODEL_FIELD]: input.model,
+        [REASONING_SUMMARY_FIELD]: null,
+        [MCP_SERVERS_FIELD]: session.mcpServers,
+        // Required by the protocol; the agent's step limit is max_tool_steps.
+        [RECURSION_LIMIT_FIELD]: session.maxToolSteps,
+        [MAX_TOOL_STEPS_FIELD]: session.maxToolSteps,
+        [RESULT_SCHEMA_FIELD]: session.resultSchema ?? null,
+        [INSTRUCTION_FIELD]: session.instruction,
+        [START_URL_FIELD]: session.startUrl,
+        [RUN_SECONDS_FIELD]: session.runSeconds,
+        [RECORDS_DIR_FIELD]: session.recordsDir ?? null,
+      }),
+    );
+
+    const exitedTask = handle.exited.then(
+      (result) => {
+        processExited = true;
+        return result;
+      },
+      (error: unknown) => {
+        processExited = true;
+        throw error;
+      },
+    );
+    stderrTask = readStderr(handle.stderr, input.logger);
+    stdoutTask = (async () => {
+      const lines = createInterface({ input: handle!.stdout, crlfDelay: Infinity });
+      for await (const line of lines) {
+        let event: DeepagentsEvent;
+        try {
+          const parsed: unknown = JSON.parse(line);
+          if (!isRecord(parsed)) throw new Error("not an object");
+          event = parsed;
+        } catch {
+          input.logger.log({
+            category: LOG_CATEGORY,
+            message: `non-JSON stdout: ${clip(sanitizeErrorMessage(line), 500)}`,
+            level: 1,
+          });
+          continue;
+        }
+        if (shouldSanitizeEvent(event)) event = deepSanitizeValue(event) as DeepagentsEvent;
+        events.push(event);
+        logEvent(input.logger, event);
+        if (event[TYPE_FIELD] === FINAL_EVENT) {
+          sawFinal = true;
+          if (typeof event[TEXT_FIELD] === "string") finalMessage = event[TEXT_FIELD];
+        }
+        if (event[TYPE_FIELD] === USAGE_EVENT) {
+          sawUsage = true;
+          tokenUsage = extractDeepagentsTokenUsage(event);
+        }
+        if (event[TYPE_FIELD] === ERROR_EVENT) {
+          // A budget stop must not be overwritten by a later error (e.g. from teardown).
+          if (errorKind !== TOOL_STEP_BUDGET_KIND) {
+            errorKind = typeof event[KIND_FIELD] === "string" ? event[KIND_FIELD] : EXCEPTION_KIND;
+            stopReason =
+              typeof event[MESSAGE_FIELD] === "string"
+                ? event[MESSAGE_FIELD]
+                : "agent program error";
+          }
+        }
+        if (event[TYPE_FIELD] === TOOL_RESULT_EVENT && typeof event[NAME_FIELD] === "string") {
+          await input.onToolResult?.(
+            event[NAME_FIELD],
+            typeof event[SERVER_FIELD] === "string" ? event[SERVER_FIELD] : undefined,
+          );
+        }
+      }
+    })();
+    const exited = await Promise.race([
+      exitedTask,
+      rejectOnFailure(stdoutTask),
+      rejectOnFailure(stderrTask),
+    ]);
+    exitCode = exited.code;
+    exitSignal = exited.signal;
+    await drainStreams(handle, [stdoutTask, stderrTask], KILL_GRACE_MS);
+    if (exitCode === null && !stopReason) {
+      stopReason = exitSignal
+        ? `agent program terminated by ${exitSignal}`
+        : "agent program exited without an exit code";
+    } else if (exitCode !== 0 && !stopReason) {
+      stopReason = `agent program exited with code ${exitCode}`;
+    }
+    if (exitCode === 0 && (!sawFinal || !sawUsage) && !stopReason) {
+      stopReason = "agent program exited without a terminal final/usage event";
+    }
+  } catch (error) {
+    iterationError = sanitizeErrorMessage(stringifyError(error));
+    stopReason = iterationError;
+    beginTermination();
+    if (handle && !processExited) {
+      await waitForExit(handle.exited, KILL_GRACE_MS);
+      if (!processExited) sendSignal(KILL_SIGNAL);
+    }
+    if (handle) await drainStreams(handle, [stdoutTask, stderrTask], KILL_GRACE_MS);
+    input.logger.warn({
+      category: LOG_CATEGORY,
+      message: `agent program stopped before a normal result: ${stopReason}`,
+      level: 0,
+      auxiliary: { error: { value: stopReason, type: STRING_AUXILIARY } },
+    });
+  } finally {
+    if (killTimer !== undefined) clearTimeout(killTimer);
+    input.signal?.removeEventListener(ABORT_EVENT, beginTermination);
+  }
+
+  const sanitizedReason = stopReason ? sanitizeErrorMessage(stopReason) : undefined;
+  return {
+    events,
+    finalMessage,
+    status: resolveDeepagentsStatus({
+      errorKind,
+      exitCode,
+      signal: exitSignal,
+      iterationError,
+      sawTerminalEvents: sawFinal && sawUsage,
+    }),
+    ...(sanitizedReason && { stopReason: sanitizedReason }),
+    tokenUsage,
+    exitCode,
+    ...(iterationError !== undefined && { iterationError }),
+  };
+}
+
+function logEvent(logger: HarnessLogger, event: DeepagentsEvent): void {
+  const type = typeof event[TYPE_FIELD] === "string" ? event[TYPE_FIELD] : UNKNOWN_EVENT;
+  const level = harnessEventLogLevel(type, {
+    isError: type === ERROR_EVENT || (type === TOOL_RESULT_EVENT && event[OK_FIELD] === false),
+    hasContent: type === ASSISTANT_EVENT || type === TOOL_RESULT_EVENT || type === FINAL_EVENT,
+  });
+  if (level === undefined) return;
+  const summary = summarizeDeepagentsEvent(event);
+  logger.log({
+    category: LOG_CATEGORY,
+    message: sanitizeErrorMessage(summary.message),
+    level,
+    auxiliary: {
+      type: { value: type, type: STRING_AUXILIARY },
+      ...(summary.detail && {
+        detail: { value: sanitizeErrorMessage(summary.detail), type: STRING_AUXILIARY },
+      }),
+    },
+  });
+}
+
+async function readStderr(stream: NodeJS.ReadableStream, logger: HarnessLogger): Promise<void> {
+  const lines = createInterface({ input: stream, crlfDelay: Infinity });
+  for await (const line of lines) {
+    logger.log({ category: LOG_CATEGORY, message: sanitizeErrorMessage(line), level: 1 });
+  }
+}
+
+function rejectOnFailure(task: Promise<void>): Promise<never> {
+  return task.then(
+    () => new Promise<never>(() => undefined),
+    (error: unknown) => Promise.reject(error),
+  );
+}
+
+async function drainStreams(
+  handle: DeepagentsProcessHandle,
+  tasks: Array<Promise<void> | undefined>,
+  timeoutMs: number,
+): Promise<void> {
+  const active = tasks.filter((task): task is Promise<void> => task !== undefined);
+  if (active.length === 0) return;
+  let timer: ReturnType<typeof setTimeout> | undefined;
+  const timedOut = await Promise.race([
+    Promise.allSettled(active).then(() => false),
+    new Promise<boolean>((resolve) => {
+      timer = setTimeout(() => resolve(true), timeoutMs);
+    }),
+  ]);
+  if (timer !== undefined) clearTimeout(timer);
+  if (!timedOut) return;
+  for (const stream of [handle.stdout, handle.stderr]) {
+    (stream as NodeJS.ReadableStream & { destroy?: () => void }).destroy?.();
+  }
+}
+
+async function waitForExit(
+  exited: Promise<{ code: number | null; signal: NodeJS.Signals | null }>,
+  timeoutMs: number,
+): Promise<void> {
+  let timer: ReturnType<typeof setTimeout> | undefined;
+  await Promise.race([
+    exited.then(
+      (): undefined => undefined,
+      (): undefined => undefined,
+    ),
+    new Promise<void>((resolve) => {
+      timer = setTimeout(resolve, timeoutMs);
+    }),
+  ]);
+  if (timer !== undefined) clearTimeout(timer);
+}
+
+/** Error events, failed tool results and anything carrying error text are redacted whole. */
+function shouldSanitizeEvent(event: DeepagentsEvent): boolean {
+  if (
+    event[TYPE_FIELD] === ERROR_EVENT ||
+    (event[TYPE_FIELD] === TOOL_RESULT_EVENT && event[OK_FIELD] === false)
+  )
+    return true;
+  return containsSensitiveTextField(event);
+}
+
+function containsSensitiveTextField(value: unknown): boolean {
+  if (Array.isArray(value)) return value.some(containsSensitiveTextField);
+  if (!isRecord(value)) return false;
+  return Object.entries(value).some(
+    ([key, child]) =>
+      (SENSITIVE_TEXT_FIELDS.has(key) && typeof child === "string") ||
+      containsSensitiveTextField(child),
+  );
+}
+
+function deepSanitizeValue(value: unknown): unknown {
+  if (typeof value === "string") return sanitizeErrorMessage(value);
+  if (Array.isArray(value)) return value.map(deepSanitizeValue);
+  if (!isRecord(value)) return value;
+  return Object.fromEntries(
+    Object.entries(value).map(([key, child]) => [key, deepSanitizeValue(child)]),
+  );
+}
