index 000000000..7f83e856d
--- /dev/null
+++ b/packages/evals/framework/karpoBrowserRunner.ts
@@ -0,0 +1,254 @@
+/**
+ * karpo-browser as an external harness (`karpo_browser`): the agent program
+ * EVAL_AGENT_BIN names (karpo-browser's adapter, an absolute path) stands in
+ * for the Deep Agents runner and speaks its protocol (see
+ * karpoBrowserSession.ts), so its events map to a trajectory exactly as Deep
+ * Agents' do. The program is started with no arguments, in the eval process's
+ * environment plus, when the row's browser is a Browserbase session, that
+ * session's id in BROWSERBASE_SESSION_ID: the program drives the row's browser
+ * over a CDP connection of its own, as the facade does not tell agents its
+ * session, and calls the `stagehand_facade` tools through the MCP servers it is
+ * given.
+ *
+ * The program reads its own model settings from its environment; the row's
+ * model is only a label, so it says nothing about the models called or their
+ * price.
+ *
+ * The agent keeps its execution records in the row's working directory; once
+ * the row's trajectory is written, they are copied into it, before the working
+ * directory is removed.
+ *
+ * Adapted from runDeepagentsAgent (packages/evals/framework/deepagentsRunner.ts
+ * at c8e096cb), Copyright (c) 2024 Browserbase Inc., MIT License (see LICENSE
+ * at the repository root).
+ */
+import fsp from "node:fs/promises";
+import path from "node:path";
+import {
+  buildDeepagentsTranscript,
+  stringifyError,
+  type DeepagentsProcessSpawner,
+} from "@browserbasehq/stagehand-integrations-deepagents-sdk";
+import type { AvailableModel } from "stagehand-v3";
+import { EvalsError } from "../errors.js";
+import type { EvalLogger } from "../logger.js";
+import type { ExternalHarnessTaskPlan } from "./externalHarnessPlan.js";
+import { deepagentsAdapter } from "./harnesses/deepagentsAdapter.js";
+import {
+  EVAL_RESULT_SCHEMA,
+  readResultContract,
+  runExternalHarnessTask,
+} from "./harnesses/externalRunner.js";
+import { AGENT_PROGRAM_HARNESS, runAgentProgramSession } from "./karpoBrowserSession.js";
+import type { PreparedAgentProgramToolAdapter } from "./karpoBrowserToolAdapter.js";
+import { resolveStepBudget } from "./stepBudget.js";
+import type { TaskResult } from "./types.js";
+import type { ExternalHarnessVerifierConfig } from "./verifierAdapter.js";
+
+/** Absolute path of the agent program. */
+export const AGENT_BIN_ENV = "EVAL_AGENT_BIN";
+/** The model id the harness's rows carry: a label only, the agent's models being its own. */
+export const AGENT_PROGRAM_MODEL = "karpo-browser/controller" as AvailableModel;
+/**
+ * Where the program finds the id of the row's Browserbase session, and the
+ * provider of a browser that is one.
+ */
+const BROWSERBASE_SESSION_ENV = "BROWSERBASE_SESSION_ID";
+const BROWSERBASE_PROVIDER = "browserbase";
+
+/** Wall-clock limit of a run, in seconds; the Deep Agents runner's own limit by default. */
+const RUN_SECONDS_ENV = "EVAL_AGENT_RUN_SECONDS";
+const DEFAULT_RUN_SECONDS = 2_400;
+/**
+ * The tool-call budget, when set for the harness; else AGENT_EVAL_MAX_STEPS, the
+ * dataset's budget or the harness's default (see resolveStepBudget).
+ */
+const MAX_STEPS_ENV = "EVAL_AGENT_MAX_STEPS";
+/**
+ * Where the agent's execution records go: a directory of the row's working
+ * directory, then one of the row's trajectory directory.
+ */
+const AGENT_RECORDS_DIR = "agent-records";
+const TRAJECTORY_AGENT_DIR = "agent";
+
+/**
+ * How the task is run: the report's contract unless one is set, and the one asking for
+ * it as JSON; the unit of the step budget; the system prompt passed as the agent's own;
+ * and the status of a session that failed.
+ */
+const DEFAULT_RESULT_CONTRACT = "marker";
+const STRUCTURED_OUTPUT_CONTRACT = "structured_output";
+const STEP_BUDGET_UNIT = "tool_calls";
+const SYSTEM_PROMPT_MODE = "native";
+const SDK_ERROR_STATUS = "sdk_error";
+
+export interface AgentProgramRunnerInput {
+  plan: ExternalHarnessTaskPlan;
+  model: AvailableModel;
+  logger: EvalLogger;
+  toolAdapter: PreparedAgentProgramToolAdapter;
+  signal?: AbortSignal;
+  spawn?: DeepagentsProcessSpawner;
+  verifier?: ExternalHarnessVerifierConfig;
+  env?: NodeJS.ProcessEnv;
+}
+
+export async function runAgentProgram({
+  plan,
+  model,
+  logger,
+  toolAdapter,
+  signal,
+  spawn,
+  verifier,
+  env = process.env,
+}: AgentProgramRunnerInput): Promise<TaskResult> {
+  const binary = env[AGENT_BIN_ENV]?.trim();
+  if (!binary || !path.isAbsolute(binary)) {
+    throw new EvalsError(`${AGENT_BIN_ENV} must be the absolute path of the agent program.`);
+  }
+  const resultContract = readResultContract(DEFAULT_RESULT_CONTRACT, env);
+  const maxToolSteps = resolveStepBudget({
+    harnessEnvKey: MAX_STEPS_ENV,
+    dataset: plan.dataset,
+    harnessDefault: 50,
+    env,
+  });
+  const runSeconds = readPositiveInt(env[RUN_SECONDS_ENV]) ?? DEFAULT_RUN_SECONDS;
+  const recordsDir = path.join(toolAdapter.cwd, AGENT_RECORDS_DIR);
+  const result = await runExternalHarnessTask({
+    harness: AGENT_PROGRAM_HARNESS,
+    plan,
+    model,
+    logger,
+    toolAdapter,
+    verifier,
+    resultContract,
+    fallbackErrorMessage: "the agent program did not report success",
+    stepBudget: maxToolSteps,
+    stepBudgetUnit: STEP_BUDGET_UNIT,
+    configuration: { runSeconds },
+    systemPromptMode: SYSTEM_PROMPT_MODE,
+    runSession: async (prompt, systemPrompt) => {
+      const sessionResult = await runAgentProgramSession({
+        prompt,
+        model,
+        logger,
+        signal,
+        spawn,
+        session: {
+          binary,
+          cwd: toolAdapter.cwd,
+          env: agentEnv(toolAdapter),
+          mcpServers: toolAdapter.mcpServers,
+          systemPrompt,
+          maxToolSteps,
+          ...(resultContract === STRUCTURED_OUTPUT_CONTRACT && {
+            resultSchema: EVAL_RESULT_SCHEMA,
+          }),
+          instruction: plan.instruction,
+          startUrl: plan.startUrl,
+          runSeconds,
+          recordsDir,
+        },
+        onToolResult: (_name: string, server?: string) => {
+          if (server && toolAdapter.recordObservation) toolAdapter.recordObservation();
+        },
+      });
+      const usage = sessionResult.tokenUsage;
+      return {
+        raw: sessionResult,
+        resultText: sessionResult.finalMessage,
+        transcriptText: buildDeepagentsTranscript(sessionResult.events),
+        iterationError: sessionResult.iterationError,
+        status: sessionResult.status,
+        stopReason:
+          sessionResult.stopReason ||
+          (sessionResult.status === SDK_ERROR_STATUS
+            ? stringifyError(sessionResult.iterationError) || undefined
+            : undefined),
+        usage: {
+          reported: usage.reported,
+          inputTokens: usage.inputTokens,
+          outputTokens: usage.outputTokens,
+          cachedInputTokens: usage.cacheReadInputTokens,
+          reasoningOutputTokens: usage.reasoningOutputTokens,
+          totalTokens: usage.totalTokens,
+        },
+        metrics: {},
+      };
+    },
+    toTrajectory: (
+      { raw, parsed, finalObservation, stepObservations, observedToolName, status },
+      taskSpec,
+    ) =>
+      deepagentsAdapter.fromHarnessResult(
+        {
+          events: raw.events,
+          ...(finalObservation && { finalObservation }),
+          ...(stepObservations?.length && { stepObservations }),
+          ...(observedToolName && { observedToolName }),
+          finalAnswer: parsed.finalAnswer ?? raw.finalMessage,
+          status,
+          usage: {
+            input_tokens: raw.tokenUsage.inputTokens,
+            output_tokens: raw.tokenUsage.outputTokens,
+            reasoning_tokens: raw.tokenUsage.reasoningOutputTokens,
+            cached_input_tokens: raw.tokenUsage.cacheReadInputTokens,
+          },
+        },
+        taskSpec,
+      ),
+  });
+  await keepAgentRecords(recordsDir, result.trajectoryDir, logger);
+  return result;
+}
+
+/**
+ * The program's environment: the tool adapter's (the eval process's own) and,
+ * when the row's browser is a Browserbase session, its id in
+ * BROWSERBASE_SESSION_ID, over any value inherited.
+ */
+function agentEnv(toolAdapter: PreparedAgentProgramToolAdapter): Record<string, string> {
+  const { provider, sessionId } = toolAdapter.browserSession;
+  return provider === BROWSERBASE_PROVIDER && sessionId
+    ? { ...toolAdapter.env, [BROWSERBASE_SESSION_ENV]: sessionId }
+    : toolAdapter.env;
+}
+
+/**
+ * Copies the agent's execution records into the row's trajectory directory,
+ * when one was written: a result names one even when trajectories are not
+ * persisted, though it is never made then. Best effort: a copy that fails is
+ * logged, and the row stands.
+ */
+async function keepAgentRecords(
+  recordsDir: string,
+  trajectoryDir: unknown,
+  logger: EvalLogger,
+): Promise<void> {
+  if (typeof trajectoryDir !== "string") return;
+  if (!(await isDirectory(trajectoryDir)) || !(await isDirectory(recordsDir))) return;
+  try {
+    await fsp.cp(recordsDir, path.join(trajectoryDir, TRAJECTORY_AGENT_DIR), { recursive: true });
+  } catch (error) {
+    logger.warn({
+      category: AGENT_PROGRAM_HARNESS,
+      message: `could not keep the agent's execution records: ${stringifyError(error)}`,
+      level: 1,
+    });
+  }
+}
+
+async function isDirectory(dir: string): Promise<boolean> {
+  try {
+    return (await fsp.stat(dir)).isDirectory();
+  } catch {
+    return false;
+  }
+}
+
+function readPositiveInt(raw: string | undefined): number | undefined {
+  const parsed = Number(raw);
+  return Number.isSafeInteger(parsed) && parsed > 0 ? parsed : undefined;
+}
