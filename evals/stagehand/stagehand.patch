+++ b/packages/evals/framework/karpoBrowserToolAdapter.ts
@@ -0,0 +1,198 @@
+/**
+ * The tool mount the `karpo_browser` harness's agent program runs on.
+ *
+ * Adapted from prepareDeepagentsToolAdapter
+ * (packages/evals/framework/deepagentsToolAdapter.ts at c8e096cb),
+ * Copyright (c) 2024 Browserbase Inc., MIT License (see LICENSE at the
+ * repository root), reusing its normalizeDeepagentsMcpServers. It changes
+ * only:
+ * - the tool surface: `stagehand_facade` alone;
+ * - a mount that is missing or not MCP: refused with one error;
+ * - its input type (ExternalHarnessPrepareInput), its temporary directory, log
+ *   category and messages;
+ * - the harness's name, the mount's kind and the variables it reads named as
+ *   module constants.
+ */
+import fsp from "node:fs/promises";
+import os from "node:os";
+import path from "node:path";
+import type { DeepagentsMcpServerConfig } from "@browserbasehq/stagehand-integrations-deepagents-sdk";
+import type { ProbeEvidence } from "stagehand-v3";
+import type { BrowserSessionLoss, StartupProfile, ToolSurface } from "../core/contracts/tool.js";
+import { EvalsError } from "../errors.js";
+import { startAgentToolRuntime } from "./agentToolRuntime.js";
+import type { ExternalHarnessPrepareInput } from "./benchHarness.js";
+import type { BrowserSessionInfo } from "./browserSession.js";
+import { normalizeDeepagentsMcpServers } from "./deepagentsToolAdapter.js";
+import { AGENT_PROGRAM_HARNESS, STRING_AUXILIARY } from "./karpoBrowserSession.js";
+import { resolveStartupProfile, resolveToolSurface } from "./harnesses/toolSurfaceResolution.js";
+import { ObservationRecorder, type StepObservation } from "./observationRecorder.js";
+
+export interface PreparedAgentProgramToolAdapter {
+  toolSurface: ToolSurface;
+  startupProfile: StartupProfile;
+  cwd: string;
+  env: Record<string, string>;
+  promptInstructions: string;
+  /** Browser behind the mounted surface, resolved before the agent starts. */
+  browserSession: BrowserSessionInfo;
+  mcpServers: Record<string, DeepagentsMcpServerConfig>;
+  captureEvidence?: () => Promise<ProbeEvidence>;
+  /** Set once the mounted browser is gone for the rest of the run. */
+  browserSessionLoss?: () => BrowserSessionLoss | undefined;
+  drainStepObservations?: () => Promise<StepObservation[]>;
+  recordObservation?: () => void;
+  observedToolMatcher: (name: string) => boolean;
+  cleanup: () => Promise<void>;
+}
+
+/**
+ * The agent calls the facade's own tools and, on Browserbase, connects to the
+ * facade's session, so it runs on the facade only.
+ */
+export const AGENT_PROGRAM_TOOL_SURFACES: ToolSurface[] = ["stagehand_facade"];
+
+/** How the agent's tools must be mounted: as MCP servers. */
+const MCP_MOUNT = "mcp";
+/** The start of the name of the run's temporary directory, its working directory. */
+const TEMP_DIR_PREFIX = "stagehand-evals-karpo-browser-";
+/** How long the mount's cleanup and an evidence capture may take, when set. */
+const MOUNT_CLEANUP_TIMEOUT_ENV = "EVAL_AGENT_MOUNT_CLEANUP_TIMEOUT_MS";
+const CAPTURE_EVIDENCE_TIMEOUT_ENV = "EVAL_CAPTURE_EVIDENCE_TIMEOUT_MS";
+
+export async function prepareAgentProgramToolAdapter(
+  input: ExternalHarnessPrepareInput,
+): Promise<PreparedAgentProgramToolAdapter> {
+  const toolSurface = resolveToolSurface(
+    {
+      harness: AGENT_PROGRAM_HARNESS,
+      supportedToolSurfaces: AGENT_PROGRAM_TOOL_SURFACES,
+    },
+    input.toolSurface,
+  );
+  if (toolSurface === undefined) {
+    throw new EvalsError(`${AGENT_PROGRAM_HARNESS} harness requires a tool surface.`);
+  }
+  const startupProfile = resolveStartupProfile(
+    toolSurface,
+    input.environment,
+    input.startupProfile,
+  );
+  const runtime = await startAgentToolRuntime({
+    toolSurface,
+    startupProfile,
+    environment: input.environment,
+    logger: input.logger,
+  });
+
+  let cwd: string | undefined;
+  try {
+    const mount = runtime.running.agentMount;
+    if (mount?.via !== MCP_MOUNT) {
+      throw new EvalsError(`Tool surface "${toolSurface}" does not provide an MCP agent mount.`);
+    }
+    const mcpServers = normalizeDeepagentsMcpServers(mount.mcpServers);
+    const recorder = runtime.running.captureEvidence
+      ? new ObservationRecorder(runtime.running.captureEvidence)
+      : undefined;
+    cwd = await fsp.mkdtemp(path.join(os.tmpdir(), TEMP_DIR_PREFIX));
+    const capturedCwd = cwd;
+    const serverNames = Object.keys(mcpServers);
+    let cleanupPromise: Promise<void> | undefined;
+
+    input.logger.log({
+      category: AGENT_PROGRAM_HARNESS,
+      message: `Initialized ${toolSurface} MCP mount for the agent program (servers: ${serverNames.join(", ")}).`,
+      level: 2,
+      auxiliary: {
+        startupProfile: { value: startupProfile, type: STRING_AUXILIARY },
+        environment: { value: input.environment, type: STRING_AUXILIARY },
+      },
+    });
+
+    return {
+      toolSurface,
+      startupProfile,
+      cwd,
+      env: { ...process.env } as Record<string, string>,
+      promptInstructions: mount.promptInstructions,
+      browserSession: runtime.browserSession,
+      mcpServers,
+      ...(runtime.running.browserSessionLoss && {
+        browserSessionLoss: runtime.running.browserSessionLoss,
+      }),
+      ...(runtime.running.captureEvidence && {
+        captureEvidence: boundedCaptureEvidence(runtime.running.captureEvidence),
+      }),
+      ...(recorder && {
+        drainStepObservations: async () => {
+          await recorder.settle();
+          return recorder.drain();
+        },
+        recordObservation: () => void recorder.record(),
+      }),
+      observedToolMatcher: (name) => serverNames.some((server) => name.startsWith(`${server}.`)),
+      cleanup: async () => {
+        cleanupPromise ??= (async () => {
+          try {
+            await withTimeout(
+              runtime.cleanup(),
+              readPositiveIntEnv(MOUNT_CLEANUP_TIMEOUT_ENV, 30_000),
+            );
+          } catch {
+            // best-effort only
+          } finally {
+            await fsp.rm(capturedCwd, { recursive: true, force: true });
+          }
+        })();
+        await cleanupPromise;
+      },
+    };
+  } catch (error) {
+    await withTimeout(
+      runtime.cleanup(),
+      readPositiveIntEnv(MOUNT_CLEANUP_TIMEOUT_ENV, 30_000),
+    ).catch((): undefined => undefined);
+    if (cwd) await fsp.rm(cwd, { recursive: true, force: true });
+    throw error;
+  }
+}
+
+function boundedCaptureEvidence(
+  capture: () => Promise<ProbeEvidence>,
+): () => Promise<ProbeEvidence> {
+  return async () => {
+    try {
+      return await withTimeout(capture(), readPositiveIntEnv(CAPTURE_EVIDENCE_TIMEOUT_ENV, 15_000));
+    } catch {
+      return {};
+    }
+  };
+}
+
+function readPositiveIntEnv(key: string, fallback: number): number {
+  const parsed = Number.parseInt(process.env[key] ?? "", 10);
+  return Number.isFinite(parsed) && parsed > 0 ? parsed : fallback;
+}
+
+function withTimeout<T>(promise: Promise<T>, timeoutMs: number): Promise<T> {
+  return new Promise<T>((resolve, reject) => {
+    const timer = setTimeout(
+      () =>
+        reject(
+          new Error(`${AGENT_PROGRAM_HARNESS} adapter operation timed out after ${timeoutMs}ms`),
+        ),
+      timeoutMs,
+    );
+    promise.then(
+      (value) => {
+        clearTimeout(timer);
+        resolve(value);
+      },
+      (error) => {
+        clearTimeout(timer);
+        reject(error);
+      },
+    );
+  });
+}
